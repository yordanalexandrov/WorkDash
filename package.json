{
  "name": "workdash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "esbuild web/src/main.tsx --bundle --minify --sourcemap --format=esm --target=es2022 --tsconfig=web/tsconfig.json --outfile=web/dist/app.js",
    "watch:web": "npm run build:web -- --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "prototype": "esbuild web/prototype/main.tsx --bundle --format=esm --target=es2022 --loader:.css=text --tsconfig=web/prototype/tsconfig.json --outdir=web/prototype/out --servedir=web/prototype --serve=5180 --watch=forever",
    "prototype:build": "esbuild web/prototype/main.tsx --bundle --format=esm --target=es2022 --loader:.css=text --tsconfig=web/prototype/tsconfig.json --outdir=web/prototype/out",
    "prototype:typecheck": "tsc --noEmit -p web/prototype",
    "prototype:snapshot": "curl -fsS http://localhost:${WORKDASH_PORT:-3000}/api/prs -o web/prototype/snapshot.json"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "preact": "^10.29.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
