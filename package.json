{
  "name": "workdash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "esbuild web/src/main.tsx --bundle --minify --sourcemap --format=esm --target=es2022 --tsconfig=web/tsconfig.json --splitting --outdir=web/dist --entry-names=app",
    "watch:web": "npm run build:web -- --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "oxlint --type-aware --deny-warnings",
    "knip": "knip",
    "guard": "node scripts/public-guard.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "knip": "^6.44.1",
    "marked": "^18.1.2",
    "mermaid": "^12.2.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "preact": "^10.29.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
